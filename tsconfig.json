{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@services/*": ["./src/services/*"],
      "@persistence/*": ["./src/persistence/*"],
      "@security/*": ["./src/security/*"],
      "@validators/*": ["./src/validators/*"]
    }
  },
  "include": ["src/**/*"]
}